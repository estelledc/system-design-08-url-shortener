{
  "name": "system-design-08-url-shortener",
  "version": "0.1.0",
  "description": "Evidence-first URL shortener with durable idempotency, collision handling, redirect receipts, and PostgreSQL integration",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.js",
    "lint": "node scripts/repo-check.mjs",
    "test": "node --test --test-reporter=spec test/unit/*.test.js",
    "test:postgres": "node --test --test-reporter=spec test/integration/*.test.js",
    "smoke:postgres": "node scripts/postgres-smoke.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "audit": "npm audit --audit-level=high",
    "check": "npm run lint && npm test && npm run benchmark && npm run audit",
    "check:ci": "npm run check && npm run test:postgres && npm run smoke:postgres"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "keywords": [
    "system-design",
    "url-shortener",
    "postgresql",
    "idempotency",
    "redirect"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estelledc/system-design-08-url-shortener.git"
  },
  "bugs": {
    "url": "https://github.com/estelledc/system-design-08-url-shortener/issues"
  },
  "homepage": "https://github.com/estelledc/system-design-08-url-shortener#readme",
  "license": "MIT"
}
